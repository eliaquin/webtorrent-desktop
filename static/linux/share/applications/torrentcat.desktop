[Desktop Entry]
Name=TorrentCat
Version=1.0
GenericName=BitTorrent Client
X-GNOME-FullName=TorrentCat
Comment=Download and share files over BitTorrent
Encoding=UTF-8
Type=Application
Icon=torrentcat
Terminal=false
Path=/opt/torrentcat
Exec=/opt/torrentcat/TorrentCat %U
TryExec=/opt/torrentcat/TorrentCat
StartupNotify=false
Categories=Network;FileTransfer;P2P;
MimeType=application/x-bittorrent;x-scheme-handler/magnet;x-scheme-handler/stream-magnet;

Actions=CreateNewTorrent;OpenTorrentFile;OpenTorrentAddress;

[Desktop Action CreateNewTorrent]
Name=Create New Torrent...
Exec=/opt/torrentcat/TorrentCat -n
Path=/opt/torrentcat

[Desktop Action OpenTorrentFile]
Name=Open Torrent File...
Exec=/opt/torrentcat/TorrentCat -o
Path=/opt/torrentcat

[Desktop Action OpenTorrentAddress]
Name=Open Torrent Address...
Exec=/opt/torrentcat/TorrentCat -u
Path=/opt/torrentcat
