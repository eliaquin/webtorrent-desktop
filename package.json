{
  "name": "webtorrent-desktop",
  "description": "WebTorrent, the streaming torrent client. For Mac, Windows, and Linux.",
  "version": "0.24.0",
  "author": {
    "name": "WebTorrent, LLC",
    "email": "feross@webtorrent.io",
    "url": "https://webtorrent.io"
  },
  "babel": {
    "plugins": [
      [
        "@babel/plugin-transform-react-jsx",
        {
          "runtime": "automatic"
        }
      ]
    ],
    "sourceType": "unambiguous"
  },
  "bugs": {
    "url": "https://github.com/webtorrent/webtorrent-desktop/issues"
  },
  "dependencies": {
    "@electron/remote": "2.1.3",
    "airplayer": "github:webtorrent/airplayer#fix-security",
    "application-config": "2.0.0",
    "arch": "2.2.0",
    "auto-launch": "5.0.6",
    "bitfield": "4.2.0",
    "capture-frame": "4.0.0",
    "chokidar": "4.0.3",
    "chromecasts": "1.10.2",
    "create-torrent": "5.0.9",
    "debounce": "1.2.1",
    "dlnacasts": "0.1.0",
    "drag-drop": "7.2.0",
    "es6-error": "4.1.1",
    "fn-getter": "1.0.0",
    "iso-639-1": "2.1.15",
    "languagedetect": "2.0.0",
    "location-history": "1.1.2",
    "music-metadata": "12.0.0",
    "network-address": "1.1.2",
    "parse-torrent": "9.1.5",
    "prettier-bytes": "1.0.4",
    "prop-types": "15.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "4.4.1",
    "run-parallel": "1.2.0",
    "semver": "7.8.5",
    "simple-concat": "1.0.1",
    "simple-get": "4.0.1",
    "srt-to-vtt": "1.1.3",
    "vlc-command": "1.2.0",
    "webtorrent": "1.9.7",
    "winreg": "1.2.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "cross-zip": "4.0.1",
    "electron": "44.7.0",
    "electron-winstaller": "5.4.4",
    "gh-release": "8.1.0",
    "minimist": "1.2.8",
    "open": "8.4.2",
    "plist": "3.1.1",
    "pngjs": "7.0.0",
    "run-series": "1.1.9",
    "standard": "17.1.2",
    "tape": "5.10.2",
    "@electron/packager": "20.3.0",
    "@electron/notarize": "3.1.1",
    "@electron/osx-sign": "2.7.1",
    "playwright": "1.64.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "homepage": "https://webtorrent.io",
  "keywords": [
    "desktop",
    "electron",
    "electron-app",
    "hybrid webtorrent client",
    "mad science",
    "torrent",
    "torrent client",
    "webtorrent"
  ],
  "license": "MIT",
  "main": "index.js",
  "optionalDependencies": {
    "electron-installer-debian": "4.0.0",
    "electron-installer-redhat": "4.0.0"
  },
  "private": true,
  "productName": "WebTorrent",
  "repository": {
    "type": "git",
    "url": "git://github.com/webtorrent/webtorrent-desktop.git"
  },
  "scripts": {
    "build": "node bin/build.js",
    "clean": "node ./bin/clean.js",
    "gh-release": "gh-release",
    "install-system-deps": "brew install fakeroot dpkg rpm",
    "open-config": "node ./bin/open-config.js",
    "package": "node ./bin/package.js",
    "start": "npm run build && electron .",
    "test": "standard",
    "test-integration": "npm run build && node ./test",
    "update-authors": "./bin/update-authors.sh",
    "watch": "node --watch --watch-path=src --watch-path=static bin/dev.js",
    "test-ui": "npm run build && electron test/ui.js",
    "test-subtitles": "npm run build && electron test/subtitles.js",
    "test-security": "npm run build && node test/security.js",
    "audit": "npm audit --audit-level=low"
  },
  "standard": {
    "parser": "@babel/eslint-parser"
  },
  "renovate": {
    "extends": [
      "github>webtorrent/renovate-config"
    ]
  },
  "overrides": {
    "ip": "file:vendor/ip-compat",
    "plist": "3.1.1",
    "@xmldom/xmldom": "0.9.12",
    "protobufjs": "8.8.0",
    "xml2js": "0.6.2",
    "tmp": "0.2.7",
    "trim-newlines": "3.0.1",
    "browserslist": "4.29.3"
  }
}
