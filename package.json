{
  "name": "webtorrent-desktop",
  "description": "WebTorrent, the streaming torrent client. For Mac, Windows, and Linux.",
  "version": "0.27.0",
  "author": {
    "name": "WebTorrent, LLC",
    "email": "feross@webtorrent.io",
    "url": "https://webtorrent.io"
  },
  "bugs": {
    "url": "https://github.com/eliaquin/webtorrent-desktop/issues"
  },
  "dependencies": {
    "bitfield": "5.0.1",
    "chokidar": "5.0.0",
    "create-torrent": "6.1.3",
    "iso-639-1": "2.1.15",
    "location-history": "1.1.2",
    "music-metadata": "12.0.0",
    "parse-torrent": "11.0.24",
    "pathe": "2.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "7.8.5",
    "vlc-command": "1.2.0",
    "webtorrent": "3.0.21",
    "winreg": "1.2.5"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@electron/osx-sign": "2.7.1",
    "@electron/packager": "20.3.0",
    "cross-zip": "4.0.1",
    "electron": "44.7.0",
    "electron-winstaller": "5.4.4",
    "esbuild": "0.28.2",
    "minimist": "1.2.8",
    "node-api-headers": "1.9.0",
    "open": "8.4.2",
    "playwright": "1.64.0",
    "plist": "3.1.1",
    "standard": "17.1.2"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "homepage": "https://github.com/eliaquin/webtorrent-desktop",
  "keywords": [
    "desktop",
    "electron",
    "electron-app",
    "hybrid webtorrent client",
    "mad science",
    "torrent",
    "torrent client",
    "webtorrent"
  ],
  "license": "MIT",
  "main": "index.js",
  "optionalDependencies": {
    "electron-installer-debian": "4.0.0",
    "electron-installer-redhat": "4.0.0"
  },
  "private": true,
  "productName": "WebTorrent",
  "repository": {
    "type": "git",
    "url": "https://github.com/eliaquin/webtorrent-desktop.git"
  },
  "scripts": {
    "build": "node bin/build.js",
    "clean": "node ./bin/clean.js",
    "install-system-deps": "brew install fakeroot dpkg rpm",
    "open-config": "node ./bin/open-config.js",
    "package": "node ./bin/package.js",
    "start": "npm run build && electron .",
    "test": "standard",
    "test-integration": "npm run build && node test/integration.js",
    "update-authors": "./bin/update-authors.sh",
    "watch": "node --watch --watch-path=src --watch-path=static bin/dev.js",
    "test-ui": "npm run build && electron test/ui.js",
    "test-audio": "node test/audio-support.js",
    "test-subtitles": "npm run build && electron test/subtitles.js",
    "test-security": "npm run build && node test/security.js",
    "audit": "npm audit --audit-level=low",
    "reset-app": "node bin/reset.js",
    "test-store": "node test/store.js",
    "test-torrent": "node test/torrent.js",
    "test-native-player": "node test/native-player.js",
    "test-native-integration": "npm run build && node test/native-player-integration.js",
    "test-all": "npm test && npm run test-dependency-helpers && npm run test-cleanup && npm run test-store && npm run test-torrent && npm run test-native-player && npm run test-security && npm run test-ui && npm run test-subtitles && npm run test-audio && npm run test-integration && npm run audit",
    "release": "node bin/release.js",
    "checksums": "node bin/checksums.js",
    "test-cleanup": "node test/cleanup.js",
    "test-dependency-helpers": "node test/dependency-helpers.js"
  },
  "renovate": {
    "extends": [
      "github>webtorrent/renovate-config"
    ]
  },
  "overrides": {
    "ip": "file:vendor/ip-compat",
    "plist": "3.1.1",
    "@xmldom/xmldom": "0.9.12",
    "xml2js": "0.6.2",
    "tmp": "0.2.7",
    "trim-newlines": "3.0.1",
    "ip-set": "file:vendor/ip-set-compat"
  },
  "maintainers": [
    {
      "name": "eliaquin",
      "url": "https://github.com/eliaquin"
    }
  ]
}
